{
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "soft_wrap": "editor_width",
  "agent": {
    "dock": "left",
    "default_profile": "ask",
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.4",
      "enable_thinking": true,
      "effort": "medium",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "terminal": {
    "font_family": ".ZedMono",
  },
  "cli_default_open_behavior": "existing_window",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "window_decorations": "server",
  "colorize_brackets": true,
  "inlay_hints": {
    "enabled": true,
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 0,
  },
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Adwaita Light",
    "dark": "Adwaita Dark",
  },
  "format_on_save": "on",
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
  },
  "gutter": {
    "folds": false,
    "runnables": false,
    "breakpoints": false,
    "min_line_number_digits": 2,
  },
  "scrollbar": {
    "show": "never",
  },
}
