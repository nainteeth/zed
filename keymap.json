[
  {
    "context": "Workspace",
    "bindings": {
      "alt-h": "workspace::ActivatePaneLeft",
      "alt-j": "workspace::ActivatePaneDown",
      "alt-k": "workspace::ActivatePaneUp",
      "alt-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {},
  },
  {
    // Unbind space to use it later as the leader key
    "context": "VimControl && !menu",
    "bindings": {
      "space": null,
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      "space h": "workspace::NewFileSplitHorizontal",
      "space v": "workspace::NewFileSplitVertical",
      "space e": "project_panel::ToggleFocus",

      "alt q": "pane::CloseActiveItem",
      "space s": "terminal_panel::ToggleFocus",

      "space f f": "file_finder::Toggle",
      "space f s": "workspace::NewSearch",

      "space l d": "editor::GoToDefinition",
      "space l r": "editor::FindAllReferences",
      "space l n": "editor::Rename",
      "space l a": "editor::ToggleCodeActions",
      "space l f": "editor::Format",
      "space l i": "editor::GoToImplementation",
      "space l s": "outline::Toggle",

      "space g g": "git_panel::Toggle",

      "space p p": "projects::OpenRecent",

      "space t": "tab_switcher::Toggle",
    },
  },
]
